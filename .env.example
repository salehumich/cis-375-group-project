# OpenAI key for API access and drafting generation. Server only, do not share this key publicly.
OPENAI_API_KEY=


# Supabase URL for database access. Public, can be shared with the client.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key for database access. Public, can be shared with the client. Because RLS restricts what is can access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key for database access. Server only, do not share this key publicly.
SUPABASE_SERVICE_ROLE_KEY=


# Google Client ID for Google OAuth authentication. Public, can be shared with the client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Client Secret for Google OAuth authentication. Server only, do not share this key publicly.
GOOGLE_CLIENT_SECRET=